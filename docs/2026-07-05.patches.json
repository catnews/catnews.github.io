      "id": 14664162,
      "title": "[net-next,4/4] selftests: net: hsr: add PRP RedBox test",
      "url": "https://lore.kernel.org/r/20260704234704.4297-5-xiexinet@gmail.com",
      "patchworkUrl": "https://patchwork.kernel.org/project/netdevbpf/patch/20260704234704.4297-5-xiexinet@gmail.com/",
